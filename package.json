{
  "name": "tekken-ru",
  "productName": "TekkenRU",
  "version": "1.0.0",
  "description": "TekkenRU — русский справочник по персонажам Tekken 8",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "pack:win": "npm run build && node scripts/pack-win.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "manifest": "node scripts/make-manifest.mjs"
  },
  "author": "Зинченко Антон Васильевич",
  "license": "UNLICENSED",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
